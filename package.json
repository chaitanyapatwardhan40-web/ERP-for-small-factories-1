{
  "name": "kitwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --tsconfig tsconfig.json src/lib/db/seed.ts",
    "db:reset": "rm -rf .data && npm run db:seed",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@electric-sql/pglite": "^0.5.16",
    "@vercel/blob": "^2.9.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "postgres": "^4.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
