# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL unset to run on an embedded database in ./.data (no setup;
# fine for development). Set it to a Postgres URL for staging and production
# (Supabase, Neon, RDS...). Migrations are applied automatically on the embedded
# database; on Postgres run `npm run db:migrate`.
# DATABASE_URL=postgres://user:password@host:5432/kitwise

# --- Demo mode ------------------------------------------------------------------
# KITWISE_DEMO=1 runs the app on an in-memory copy of the sample company
# (data/demo.tar.gz) and needs no database. It is on by default on Vercel when
# DATABASE_URL is not set; KITWISE_DEMO=0 turns it off.
# KITWISE_DEMO=1

# --- Files ------------------------------------------------------------------------
# Uploaded drawings and documents go to Vercel Blob when this is set, otherwise
# to ./.data/uploads (or the system temp folder in demo mode).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# --- Import assistant (optional) --------------------------------------------------
# When set, the import wizard uses a language model to map spreadsheet columns
# and flag data problems. Without it, columns are matched by header name.
# ANTHROPIC_API_KEY=sk-ant-...
