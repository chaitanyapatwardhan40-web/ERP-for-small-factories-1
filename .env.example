# --- Database -----------------------------------------------------------------
# Leave DATABASE_URL unset to run on an embedded PGlite database in ./.data
# (zero setup; fine for development and demos). Set it to a Postgres URL for
# staging and production (Supabase, Neon, RDS...). Migrations are applied
# automatically on first use in PGlite; on Postgres run `npm run db:migrate`.
# DATABASE_URL=postgres://user:password@host:5432/kitwise

# --- Auth ---------------------------------------------------------------------
# Random string (32+ chars) used to sign nothing yet but reserved for CSRF /
# magic links. Session tokens are random and stored hashed in the database.
SESSION_SECRET=change-me-to-a-long-random-string

# --- AI (optional) --------------------------------------------------------------
# When set, the implementer uses Claude to map spreadsheet columns and clean
# messy data during import. Without it, imports fall back to header heuristics.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Email (optional, not wired yet) --------------------------------------------
# RESEND_API_KEY=re_...

# --- App ----------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Kitwise
